# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Generated localization output (regenerated automatically by `flutter pub
# get` / `flutter gen-l10n` because pubspec.yaml sets `generate: true`)
lib/l10n/app_localizations.dart
lib/l10n/app_localizations_*.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/app/.cxx/
/android/.gradle/
/android/gradlew.bat.log

# iOS/macOS build artifacts
**/Pods/
**/*.xcuserstate
**/xcuserdata/

# Firebase configuration (project-specific secrets)
# Regenerate these for your own Firebase project via `flutterfire configure`,
# or copy the matching .example file and fill in your own values.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Environment variables
.env
.env.*
!.env.example

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini

# Python (only relevant if a Flask/ML backend is added under e.g. backend/ or plant/)
__pycache__/
*.pyc
venv/
.venv/
*.h5
*.pt
*.onnx
*.tflite
